{
  "name": "smart-food-route",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && npm run typecheck:edge",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions/geo/index.ts",
    "test": "vitest",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "audit:security": "node scripts/audit-security.mjs",
    "live:audit": "node scripts/live-supabase.mjs audit",
    "live:security": "node scripts/live-supabase.mjs security",
    "live:planner": "node scripts/live-planner.mjs",
    "format": "prettier --write src tests e2e *.ts *.json *.js",
    "check": "npm run lint && npm run typecheck && npm run test -- --run && npm run test:security && npm run build && npm run audit:security"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "deno": "^2.9.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "node": "^24.21.0",
    "prettier": "^3.9.8",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
